{
  "name": "allflame-voyage-helper",
  "version": "0.1.5",
  "private": true,
  "description": "Read-only Path of Exile Allflame Voyage helper overlay and optimizer.",
  "author": "MBRmurphy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MBRmurphy/allflame-voyage-helper.git"
  },
  "bugs": {
    "url": "https://github.com/MBRmurphy/allflame-voyage-helper/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/shared/voyage-core.js && node --check src/shared/update-core.js && node --check src/control.js && node --check src/overlay.js && node test.js && node update-test.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.poe.allflame.voyage.helper",
    "productName": "PoE Allflame Voyage Helper",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "icon": "build/scuba-diver-helmet.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PoE-Allflame-Voyage-Helper.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  }
}
